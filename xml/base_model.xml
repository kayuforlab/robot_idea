<mujoco>


  <visual>
    <!-- 生成される動画の画質を良くする． -->
    <global offwidth="1024" offheight="1024"/> 
    <!-- メッシュの分割数調整．影をどれくらいつけるのか -->
    <quality numslices="36" shadowsize="0" />

  </visual>



  <asset>
    <!-- 地面 -->
    <!-- <texture name="world_grid" type="2d" builtin="checker" rgb1=".4 .4 .4" rgb2=".1 .1 .3" width="100" height="100"/> 市松模様-->
    <texture name="gray_field" type="2d" builtin="flat" rgb1=".5 .5 .5" width="100" height="100"/>
    <material name="field_material" texture="gray_field" reflectance=".2"/>
    <!--標高データ size="横（フィールドの半分の大きさ）　縦　倍率　マージンの高さ"-->
    <!-- <hfield name="myfloor"  size="1 1 1 1"  file="C:\Users\moonshot\Desktop\Lab\practice\mujoco_practice\terrain\terrain_img\terrain_gray_map.png"/> -->
    <!-- <hfield name="myfloor"  size="1 1 1 1"  file="C:\Users\moonshot\Desktop\Lab\practice\mujoco_practice\terrain\terrain_img\grayscale_4blocks.png" nrow="4096" ncol="4096"/> -->


    <!-- 空 -->
    <texture name="world_texture" type="skybox" builtin="gradient" rgb1="0 0.5 0.9" rgb2="1 1 1" width="100"/>


    <!-- ロボット -->
    <!-- <mesh name="body" scale=".001 .001 .001" inertia="exact"  refquat="0.70710 -0.70710 0 0"  file="C:\Users\moonshot\Desktop\Lab\practice\mujoco_practice\robot\body_v3.stl" />
    <mesh name="wheel" scale=".001 .001 .001" inertia="exact" refquat="0.70710 -0.70710 0 0"  file="C:\Users\moonshot\Desktop\Lab\practice\mujoco_practice\robot\wheel_v3.stl" /> -->

    <!-- check -->
    <!-- <mesh name="wheel" scale=".001 .001 .001" inertia="exact"  refquat="1 0 0 0"  file="mesh\wheel.stl" /> -->
    <!-- <mesh name="wheel" scale=".001 .001 .001" inertia="exact"  refquat="1 0 0 0"  file="mesh\fan.stl" /> -->
    <mesh name="wheel" scale=".001 .001 .001" inertia="exact"  refquat="1 0 0 0"  file="mesh\one_way_grouser.stl" />

  </asset>


  
  
  <worldbody>
    <!-- Wrold全体を照らすライトと床 -->
    <light name="main_light" pos="0 0 3" directional="true" diffuse="1.5 1.5 1.5" specular="0.1 0.1 0.1"/>


    <!-- filed -->
    <!-- <geom name="floor" type="plane" pos="0 0 0" size="2 2 .1" material="field_material"/> -->
    <!-- <geom name="floor3" type="plane" pos="0 0 1" size="2 2 .1" material="field_material"/> -->
    <!-- <geom type="hfield" material="field_material" conaffinity="1" condim="3" hfield="myfloor"  name="floor2" pos="0 0 0" rgba="0.8 0.9 0.8 1" /> -->


    <!-- 目標位置の目印 -->
    <!-- <site name="anchor" pos="2 2 .1" size=".1"/> -->

    <!-- target -->
    <!-- <site name="target" pos="1 1 0" size=".1" rgba="1 0 0 1" /> -->
    <body name="target_body" pos="0 0 0" gravcomp="1">
      <!-- XY平面スライド用に2つの slide joint を追加 -->
      <joint name="slide_x" type="slide" axis="1 0 0"/>
      <joint name="slide_y" type="slide" axis="0 1 0"/>
      <joint name="slide_z" type="slide" axis="0 0 1"/>
      <!-- 衝突無視 -->
      <geom name="target_box" type="box" size="0.01 0.01 0.01" contype="0" conaffinity="0"/>
      <!-- 表示用 site -->
      <site name="target" type="cylinder" pos="0 0 0" size="0.25 0.15" rgba="1 0 0 0.3"/>
    </body>


    
    <!-- <body name="target_body" pos="0 0 0"> -->
      <!-- XY平面スライド用に2つの slide joint を追加 -->
      <!-- <joint name="slide_x" type="slide" axis="1 0 0"/>
      <joint name="slide_y" type="slide" axis="0 1 0"/>
      <joint name="z_hinge" type="hinge" axis="0 0 1"/> -->
      <!-- 衝突無視 -->
      <!-- <geom name="target_box" type="box" size="0.2 5 0.2" rgba="1 0 0 0.5" contype="0" conaffinity="0"/> -->
      <!-- 表示用 site -->
      <!-- <site name="target" pos="0 0 0" size="0.3" rgba="1 0 0 1"/> -->
    <!-- </body> -->



    <camera name="main_cam" pos="2 -0.7 2.2" euler="42 0 0"/>
    <!-- <camera name="main_cam" pos="2 -1.7 3" euler="42 0 0"/> -->


    <body name="2wheel_rover" pos="2 2 1.5">
      <joint name="body_free_joint" type="free" damping="1" />

      <!-- body -->
      <body name = "main_body">
        <geom name="main_body_geom" group="2" type="cylinder" fromto=".065 0 0 -.065 0 0" size=".05" mass="0.5" />      
      </body>
      
      <site name="marker" pos="0 -0.0005 0.001" size="0.05" type="sphere" rgba="1 0 0 1"/>
      <site name="IMU" pos="0 0 0" size="0.01" rgba="1 0 1 1"/>
      <site name="GYRO" pos="0 0 0" size="0.01" rgba="0 1 1 1"/>
      <site name="VELOCITY" pos="0 0 0" size="0.01" rgba="0 1 1 1"/>

     <!-- wheel -->
      <body name="r_wheel" pos="0.07 0 0">
        <!-- <joint name="r_wheel_joint" type="hinge" axis="1 0 0" damping="0.1" actuatorfrclimited="false" actuatorfrcrange="-0.2 0.2" /> -->
        <joint name="r_wheel_joint" type="hinge" axis="-1 0 0" damping="0.3" frictionloss="0.01" />
        <!-- frictionは滑り，ねじり，転がり　の順 -->
        <!-- <geom name="r_wheel_geom" type="cylinder" fromto="0 0 0  .08 0 0" size=".075" mass="0.25" friction="1 0.1 0.1" /> -->
        <!-- <geom name="r_wheel_geom" type="mesh" mesh="wheel" mass="0.25" pos="0 0.03 0" friction="1 0.1 0.1" /> -->
        <geom name="r_wheel_geom" group="2" type="mesh" mesh="wheel" mass="0.25" pos="0 0.03 0" friction="1 0.1 0.1" />
      </body>
      <body name="l_wheel" pos="-0.15 0 0">
        <joint name="l_wheel_joint" type="hinge" axis="-1 0 0" damping="0.3" frictionloss="0.01"/>
        <!-- <geom name="l_wheel_geom" type="cylinder" fromto="0 0 0  .08 0 0" size=".075" mass="0.25" friction="1 0.1 0.1"/> -->
        <geom name="l_wheel_geom" group="2" type="mesh" mesh="wheel" mass="0.25"  pos="0 0.03 0" friction="1 0.1 0.1"/>
      </body>

      <!-- stabilzer -->
      <geom name="stabilizer" group="2" type="box" size="0.01 0.07 0.005" pos="0 -0.049497 -0.049497" euler="45 0 0" mass="0.2" />

    </body>
    
    <!-- 貫通しない用の平面 -->
    <geom name="floor" group="1" type="plane" pos="5 5 0" size="5 5 .001" material="field_material"  rgba="0 0 0 0" />

    <!-- <body pos="0 0 1" >
      <joint type="free"/>

      <geom  name="rover_body" type="mesh" mesh="body"/>
      <site name="IMU" pos="0 0 0" size="0.01" rgba="1 1 1 1"/>

      <body name="r_wheel" pos="0.07 0 0">
        <joint name="r_wheel_joint" type="hinge" axis="1 0 0"/>
        <geom name="r_wheel_geom" type="mesh" mesh="wheel" material="field_material"/>
      </body>
      <body name="l_wheel" pos="-0.150 0 0">
        <joint name="l_wheel_joint" type="hinge" axis="1 0 0"/>
        <geom name="l_wheel_geom" type="mesh" mesh="wheel" />
      </body>
    </body> -->
  
  </worldbody>



  <actuator>
    <!-- swingがトルクをかける対象，gearはモータが関節に与えるスケーリング係数トルク = モーター出力 * gear） -->
    <!-- 入力に対して何倍してトルクを出すかということ -->
    <!-- <velocity name="r_motor" joint="r_wheel_joint" gear="1" kv="2" ctrllimited="true" ctrlrange="-4.7319 4.7319" forcelimited="true" forcerange="-2.94 2.94" /> -->
    <!-- <velocity name="l_motor" joint="l_wheel_joint" gear="1" kv="2" ctrllimited="true" ctrlrange="-4.7319 4.7319" forcelimited="true" forcerange="-2.94 2.94" /> -->
    <intvelocity name="r_motor" joint="r_wheel_joint" gear="1" kp="1" actrange="-inf inf" ctrllimited="true" ctrlrange="-5.2359877 5.2359877" forcelimited="true" forcerange="-2.94 2.94" />
    <intvelocity name="l_motor" joint="l_wheel_joint" gear="1" kp="1" actrange="-inf inf" ctrllimited="true" ctrlrange="-5.2359877 5.2359877" forcelimited="true" forcerange="-2.94 2.94" />
  </actuator>



  <sensor>
    <accelerometer name="accelerometer" site="IMU"/>
    <gyro name="gyro" site="GYRO"/>
    <velocimeter name="velocimeter" site="VELOCITY"/>
  </sensor>



</mujoco>
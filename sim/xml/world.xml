<mujoco model="world">
  <!--
    Base scene: sky, lighting, camera and a collision-only ground plane.
    No robot and no terrain here -- the robot is attached from its own
    ./<robot_name>/xml/robot.xml via MjSpec.attach(), and voxel terrain is
    generated on top of this by sim/terrain.py.
  -->
  <compiler angle="radian"/>

  <visual>
    <global offwidth="1024" offheight="1024"/>
    <quality shadowsize="0" numslices="36"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient" rgb1="0 0.5 0.9" rgb2="1 1 1" width="100" height="100"/>
    <texture name="ground_tex" type="2d" builtin="flat" rgb1="0.5 0.5 0.5" width="100" height="100"/>
    <material name="ground_material" texture="ground_tex" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light name="main_light" pos="0 0 3" dir="0 0 -1" directional="true" diffuse="1.5 1.5 1.5" specular="0.1 0.1 0.1"/>
    <camera name="main_cam" pos="1.3 -1.3 1.3" euler="55 0 45"/>

    <!-- invisible collision plane so nothing falls through gaps in the voxel terrain -->
    <geom name="ground" type="plane" size="0 0 0.01" material="ground_material" group="1" rgba="0 0 0 0"/>
  </worldbody>
</mujoco>
